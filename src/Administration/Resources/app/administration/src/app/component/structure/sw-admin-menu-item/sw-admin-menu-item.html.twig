{% block sw_admin_menu_item %}
<!-- mt-collapsible: expandable branches (expanded sidebar L1–L2, or nested flyout) -->
<!-- eslint-disable vuejs-accessibility/click-events-have-key-events, vuejs-accessibility/mouse-events-have-key-events, vuejs-accessibility/no-static-element-interactions, vuejs-accessibility/interactive-supports-focus -->
<MtCollapsible
    v-if="showMenuItem && usesCollapsible"
    as="li"
    :class="collapsibleLiClass"
    :aria-current="subIsActive(entryPath, entry.id) ? 'page' : 'false'"
    :open="collapsibleOpen"
    @update:open="onCollapsibleOpenUpdate"
    @mouseenter="$emit('menu-item-hover', entry, $event.currentTarget)"
>
    <div class="sw-admin-menu__navigation-item-row">

        {# Row with router link + dedicated expand trigger #}
        <template v-if="entryPath">
            <router-link
                class="sw-admin-menu__navigation-link"
                :class="{ 'router-link-active': subIsActive(entryPath, entry.id) }"
                :to="getLinkToProp"
                @pointerdown="emitMenuInteractionForFlyoutDismiss($event)"
            >
                {% block sw_admin_menu_item_icon_linked %}
                <mt-icon
                    v-if="displayIcon"
                    :size="iconSize"
                    class="sw-admin-menu__navigation-link-icon"
                    :name="getIconName(entry.icon, subIsActive(entry.path || entry.id, entry.id))"
                />
                {% endblock %}

                {% block sw_admin_menu_item_text_linked %}
                <span
                    class="sw-admin-menu__navigation-link-label"
                    :class="collapsibleText ? 'collapsible-text' : ''"
                    :title="getEntryLabel"
                >
                    {{ getEntryLabel }}
                </span>
                {% endblock %}

                {% block sw_admin_menu_item_router_arrow %}
                <mt-icon
                    v-if="entry.level > 1 && children.length"
                    name="regular-chevron-right"
                    size="8"
                    class="sw-admin-menu__navigation-link-icon-arrow"
                />
                {% endblock %}

                <slot name="additional-text"></slot>
            </router-link>

            <MtCollapsibleTrigger
                type="button"
                class="sw-admin-menu__navigation-submenu-expand"
                :aria-label="getEntryLabel"
                @pointerdown="emitMenuInteractionForFlyoutDismiss($event)"
            >
                <span class="sw-admin-menu__navigation-link-expand-icon-box">
                    <mt-icon
                        :name="expandIcon"
                        size="8"
                        class="sw-admin-menu__navigation-link-expand-icon collapsible-text"
                    />
                </span>
            </MtCollapsibleTrigger>
        </template>

        {# Folder row without link: full-width trigger #}
        <MtCollapsibleTrigger
            v-else
            type="button"
            class="sw-admin-menu__navigation-link"
            :class="{ 'router-link-active': subIsActive(entry.id) }"
            @pointerdown="emitMenuInteractionForFlyoutDismiss($event)"
        >
            {% block sw_admin_menu_item_navigation_icon_fold %}
            <mt-icon
                v-if="displayIcon"
                :size="iconSize"
                class="sw-admin-menu__navigation-link-icon"
                :name="getIconName(entry.icon, subIsActive(entry.path || entry.id, entry.id))"
            />
            {% endblock %}

            {% block sw_admin_menu_item_navigation_text_fold %}
            <span
                class="sw-admin-menu__navigation-link-label"
                :class="collapsibleText ? 'collapsible-text' : ''"
                :title="getEntryLabel"
            >
                {{ getEntryLabel }}
            </span>
            {% endblock %}

            <slot name="additional-text"></slot>

            {% block sw_admin_menu_item_expand_indicator_fold %}
            <span
                v-if="children.length"
                class="sw-admin-menu__navigation-link-expand-icon-box"
            >
                <mt-icon
                    :name="expandIcon"
                    size="8"
                    class="sw-admin-menu__navigation-link-expand-icon collapsible-text"
                />
            </span>
            {% endblock %}
        </MtCollapsibleTrigger>
    </div>

    {% block sw_sidebar_sub_items_collapsible %}
    <MtCollapsibleContent
        as="ul"
        class="sw-admin-menu__sub-navigation-list"
    >
        <template
            v-for="(childEntry, subMenuIndex) in children"
            :key="getStableSubMenuItemKey(childEntry, subMenuIndex)"
        >
            <sw-admin-menu-item
                v-if="menuDepth === 1"
                :entry="childEntry"
                :menu-depth="2"
                :display-icon="false"
                :sidebar-expanded="sidebarExpanded"
                :collapsible-text="collapsibleText"
                :icon-size="iconSize"
                @menu-item-hover="forwardMenuItemHover"
                @menu-item-click="forwardMenuItemClick"
                @branch-toggle="forwardBranchToggle"
            />
            <sw-admin-menu-item
                v-else
                :entry="childEntry"
                :menu-depth="3"
                :display-icon="false"
                :sidebar-expanded="sidebarExpanded"
                :collapsible-text="collapsibleText"
                :icon-size="iconSize"
                @menu-item-hover="forwardMenuItemHover"
                @menu-item-click="forwardMenuItemClick"
                @branch-toggle="forwardBranchToggle"
            />
        </template>
    </MtCollapsibleContent>
    {% endblock %}
</MtCollapsible>

{# Collapsed sidebar: level-1 folders use hover flyout; keep classic row + hidden nested list #}
<li
    v-else-if="showMenuItem && hasCollapsibleSubtree"
    :class="legacyLiClass"
    :aria-current="subIsActive(entryPath, entry.id) ? 'page' : 'false'"
    @mouseenter="$emit('menu-item-hover', entry, $event.target)"
    @click.prevent="handleLegacyRowClick($event)"
    @keydown.enter="handleLegacyRowClick($event)"
    @keydown.space="handleLegacyRowClick($event)"
>
    {% block legacy_row %}
    <div class="sw-admin-menu__navigation-item-row">

        {% block sw_admin_menu_item_router_link %}
        <router-link
            v-if="entryPath"
            class="sw-admin-menu__navigation-link"
            :class="{ 'router-link-active': subIsActive(entryPath, entry.id) }"
            :to="getLinkToProp"
        >
            {% block sw_admin_menu_item_icon %}
            <mt-icon
                v-if="displayIcon"
                :size="iconSize"
                class="sw-admin-menu__navigation-link-icon"
                :name="getIconName(entry.icon, subIsActive(entry.path || entry.id, entry.id))"
            />
            {% endblock %}

            {% block sw_admin_menu_item_text %}
            <span
                class="sw-admin-menu__navigation-link-label"
                :class="collapsibleText ? 'collapsible-text' : ''"
                :title="getEntryLabel"
            >
                {{ getEntryLabel }}
            </span>
            {% endblock %}

            {% block sw_admin_menu_item_arrow_indicator_link %}
            <mt-icon
                v-if="entry.level > 1 && children.length"
                name="regular-chevron-right"
                size="8"
                class="sw-admin-menu__navigation-link-icon-arrow"
            />
            {% endblock %}

            <slot name="additional-text"></slot>
        </router-link>
        {% endblock %}

        {% block sw_admin_menu_item_external_link %}
        <a
            v-else-if="entry.link"
            :href="entry.link"
            :target="entry.target"
            :title="$tc(entry.label)"
            class="sw-admin-menu__navigation-link"
        >
            {% block sw_admin_menu_item_external_icon %}
            <mt-icon
                v-if="displayIcon"
                :size="iconSize"
                class="sw-admin-menu__navigation-link-icon"
                :name="getIconName(entry.icon, subIsActive(entry.path || entry.id, entry.id))"
            />
            {% endblock %}

            {% block sw_admin_menu_item_external_text %}
            <span
                class="sw-admin-menu__navigation-link-label"
                :class="collapsibleText ? 'collapsible-text' : ''"
                :title="getEntryLabel"
            >
                {{ getEntryLabel }}
            </span>
            {% endblock %}

            {% block sw_admin_menu_item_external_arrow_indicator %}
            <mt-icon
                v-if="entry.level > 1 && children.length"
                name="regular-chevron-right"
                size="8"
                class="sw-admin-menu__navigation-link-icon-arrow"
            />
            {% endblock %}

            <slot name="additional-text"></slot>
        </a>
        {% endblock %}

        {% block sw_admin_menu_item_navigation_link %}
        <span
            v-else
            class="sw-admin-menu__navigation-link"
            :class="{ 'router-link-active': subIsActive(entry.id) }"
        >
            {% block sw_admin_menu_item_navigation_icon %}
            <mt-icon
                v-if="displayIcon"
                :size="iconSize"
                class="sw-admin-menu__navigation-link-icon"
                :name="getIconName(entry.icon, subIsActive(entry.path || entry.id, entry.id))"
            />
            {% endblock %}

            {% block sw_admin_menu_item_navigation_text %}
            <span
                class="sw-admin-menu__navigation-link-label"
                :class="collapsibleText ? 'collapsible-text' : ''"
                :title="getEntryLabel"
            >
                {{ getEntryLabel }}
            </span>
            {% endblock %}

            <slot name="additional-text"></slot>

            {% block sw_admin_menu_item_arrow_indicator %}
            <mt-icon
                v-if="!sidebarExpanded && entry.level > 1 && children.length"
                name="regular-chevron-right"
                size="8"
                class="sw-admin-menu__navigation-link-icon-arrow"
            />
            {% endblock %}

            {% block sw_admin_menu_item_expand_indicator %}
            <mt-icon
                v-if="children.length"
                :name="expandIcon"
                size="8"
                class="sw-admin-menu__navigation-link-expand-icon collapsible-text"
            />
            {% endblock %}
        </span>
        {% endblock %}
    </div>
    {% endblock %}

    {% block sw_sidebar_sub_items_legacy %}
    <ul
        v-if="children.length > 0"
        class="sw-admin-menu__sub-navigation-list"
    >
        <template
            v-for="(childEntry, subMenuIndex) in children"
            :key="getStableSubMenuItemKey(childEntry, subMenuIndex)"
        >
            <sw-admin-menu-item
                v-if="menuDepth === 1"
                :entry="childEntry"
                :menu-depth="2"
                :display-icon="false"
                :sidebar-expanded="sidebarExpanded"
                :collapsible-text="collapsibleText"
                :icon-size="iconSize"
                @menu-item-hover="forwardMenuItemHover"
                @menu-item-click="forwardMenuItemClick"
                @branch-toggle="forwardBranchToggle"
            />
            <sw-admin-menu-item
                v-else
                :entry="childEntry"
                :menu-depth="3"
                :display-icon="false"
                :sidebar-expanded="sidebarExpanded"
                :collapsible-text="collapsibleText"
                :icon-size="iconSize"
                @menu-item-hover="forwardMenuItemHover"
                @menu-item-click="forwardMenuItemClick"
                @branch-toggle="forwardBranchToggle"
            />
        </template>
    </ul>
    {% endblock %}
</li>

{# Leaf entries (including level-3 navigation rows) #}
<li
    v-else-if="showMenuItem"
    :class="legacyLiClass"
    :aria-current="subIsActive(entryPath, entry.id) ? 'page' : 'false'"
    @mouseenter="$emit('menu-item-hover', entry, $event.target)"
    @click.prevent="handleLegacyRowClick($event)"
    @keydown.enter="handleLegacyRowClick($event)"
    @keydown.space="handleLegacyRowClick($event)"
>
    <div class="sw-admin-menu__navigation-item-row">

        <router-link
            v-if="entryPath"
            class="sw-admin-menu__navigation-link"
            :class="{ 'router-link-active': subIsActive(entryPath, entry.id) }"
            :to="getLinkToProp"
        >
            <mt-icon
                v-if="displayIcon"
                :size="iconSize"
                class="sw-admin-menu__navigation-link-icon"
                :name="getIconName(entry.icon, subIsActive(entry.path || entry.id, entry.id))"
            />

            <span
                class="sw-admin-menu__navigation-link-label"
                :class="collapsibleText ? 'collapsible-text' : ''"
                :title="getEntryLabel"
            >
                {{ getEntryLabel }}
            </span>

            <slot name="additional-text"></slot>
        </router-link>

        <a
            v-else-if="entry.link"
            :href="entry.link"
            :target="entry.target"
            :title="$tc(entry.label)"
            class="sw-admin-menu__navigation-link"
        >
            <mt-icon
                v-if="displayIcon"
                :size="iconSize"
                class="sw-admin-menu__navigation-link-icon"
                :name="getIconName(entry.icon, subIsActive(entry.path || entry.id, entry.id))"
            />

            <span
                class="sw-admin-menu__navigation-link-label"
                :class="collapsibleText ? 'collapsible-text' : ''"
                :title="getEntryLabel"
            >
                {{ getEntryLabel }}
            </span>

            <slot name="additional-text"></slot>
        </a>

        <span
            v-else
            class="sw-admin-menu__navigation-link"
            :class="{ 'router-link-active': subIsActive(entry.id) }"
        >
            <mt-icon
                v-if="displayIcon"
                :size="iconSize"
                class="sw-admin-menu__navigation-link-icon"
                :name="getIconName(entry.icon, subIsActive(entry.path || entry.id, entry.id))"
            />

            <span
                class="sw-admin-menu__navigation-link-label"
                :class="collapsibleText ? 'collapsible-text' : ''"
                :title="getEntryLabel"
            >
                {{ getEntryLabel }}
            </span>

            <slot name="additional-text"></slot>
        </span>
    </div>
</li>
{% endblock %}
